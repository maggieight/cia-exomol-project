author = {Laurent Fissiaux and Quentin Deli\`{e}re and Ghislain Blanquet and S\'{e}verine Robert and Ann Carine Vandaele and Muriel Lep\`{e}re},
keywords = {Collisional broadenings, CH, Carbon dioxide, Planetary atmospheres, ExoMarsTGO, NOMAD, Diode-laser},
abstract = {Using a tunable diode-laser spectrometer, we have measured the CO2-broadening coefficients of 28 absorption lines in the Î½4 band of CH4. Each line was recorded at room temperature (296K) and at 4 different pressures, ranging from 8 to 50mbar. The experimental determination of the CO2-broadening coefficients was performed by fitting a theoretical profile to the experimental profile of each line recorded at each pressure. Voigt, Rautianâ€“Sobelâ€™man and Galatry models were therefore used. The impact of these determinations on atmospheric investigations on CO2-rich planetary atmospheres are addressed.}
}

